# ─── Frontend environment ────────────────────────────────────────────
# Copy to .env.local and adjust. All Vite client vars must be prefixed
# VITE_ to be exposed to the browser.

# Base URL of the backend REST API (include the /api suffix)
VITE_API_URL=http://localhost:3000/api

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000

# Origin of the backend for the Socket.io connection
VITE_SOCKET_URL=http://localhost:3000

# Realtime chat over websockets. "true" to enable; anything else falls
# back to refetch-based messaging.
VITE_ENABLE_CHAT_SOCKET=true
