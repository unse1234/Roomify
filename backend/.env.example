# ─── Backend environment ─────────────────────────────────────────────
# Copy to .env and fill in real values. The server validates this file
# at boot (src/config/config.js) and refuses to start if anything is
# missing or malformed.

# Runtime
NODE_ENV=development
PORT=3000

# Database — MongoDB MUST be a replica set (or Atlas); transactions are
# used by bookings, reviews and chat and fail on a standalone mongod.
MONGO_URI=mongodb://127.0.0.1:27017/roomify?replicaSet=rs0

# Auth — JWT_SECRET must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Web origin of the frontend (required in production). Used for CORS on
# both the REST API and Socket.io.
FRONTEND_URL=http://localhost:5173

# Cookie SameSite policy: "none" for cross-site API/frontend (needs HTTPS),
# "lax" when they share a site (recommended — restores CSRF protection).
COOKIE_SAMESITE=none

# Express "trust proxy". Set to the number of proxies in front of the API
# (e.g. 1 behind a single load balancer / Render / Railway). Leave blank
# for local development. Getting this wrong breaks per-IP rate limiting.
TRUST_PROXY=

# ImageKit (property image storage)
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ─── Performance ──────────────────────────────────────────────────────────
# MongoDB connection pool. The ceiling on concurrent database work is
#   maxPoolSize / (round-trip time to the cluster + server execution time)
# so the right value depends on how far the app is deployed from Atlas.
# Measure the round trip first (GET /__perf?ping=1) instead of guessing —
# raising this only helps once the pool is actually the scarce resource,
# and every connection is also counted against the Atlas cluster's own
# connection limit (500 on M0). See docs/performance.md.
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# Temporary profiling. Adds Server-Timing headers to the property search and
# mounts GET /__perf (event-loop delay, CPU used, cgroup quota + throttling
# counters, connection pool saturation) and GET /__perf/profile (V8 CPU
# profile). Leave false in normal operation; turn it on only while
# investigating, and set a token whenever the deployment is public.
PERF_DIAGNOSTICS=false
PERF_DIAGNOSTICS_TOKEN=

# Disables rate limiting. Load testing only — never in a real deployment.
DISABLE_RATE_LIMITING=false
